# Metered.ca TURN REST API — used by broadcaster.py (Pi) and client.html (browser)
# fetches short-lived iceServers credentials at connect time
METERED_DOMAIN=agrirover.metered.live
METERED_API_KEY=your-metered-api-key

# Base URL of the deployed signalling server — used by broadcaster.py
SIGNALLING_URL=https://your-app.onrender.com
